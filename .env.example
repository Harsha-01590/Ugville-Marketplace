# Ugville Environment Configuration — template
#
# The suite is multi-environment. Copy this file to one per environment:
#   .env.qa      .env.uat      .env.staging
# and select which one loads with the ENV variable:
#   ENV=uat npx playwright test      (default when ENV is unset)
#   ENV=qa  npx playwright test
# Any value here can also be overridden inline, e.g.:
#   ENV=uat UGVILLE_PASSWORD=... npx playwright test
# All .env.* files (except this .example) are git-ignored.

# Base URL for the Ugville site (per environment)
BASE_URL=https://homevestors--qa.sandbox.my.site.com/ugville

# Login credentials (primary session used by the whole suite)
UGVILLE_USERNAME=your_username@homevestors.com.qa
UGVILLE_PASSWORD=your_password

# Second-role credentials for permission/access-restriction tests (optional —
# tests using these skip/throw at runtime if left blank)
COORDINATOR_USERNAME=your_coordinator_username@homevestors.com.qa
COORDINATOR_PASSWORD=your_coordinator_password
BUYER_USERNAME=your_buyer_username@homevestors.com.qa
BUYER_PASSWORD=your_buyer_password

# Second franchise account — a *different* Ugville/Salesforce user belonging
# to another franchise, used for cross-account marketplace tests (e.g. list
# an Opportunity as the primary UGVILLE_USERNAME account, then view/accept it
# as this one). Optional — tests using it skip at runtime if left blank.
FRANCHISE_B_USERNAME=your_second_franchise_username@homevestors.com.qa
FRANCHISE_B_PASSWORD=your_second_franchise_password
FRANCHISE_B_NAME=

# Marketplace fixture Opportunity records for the real "List in Marketplace"
# mutation flow (optional — the marketplace eligibility/messages suites skip
# themselves if left blank). Use records designated safe for mutation.
#
# ENV-PARITY NOTE: these are the only remaining source of a coverage
# difference between environments. Populate them in EVERY .env.<ENV> (with a
# synthetic, zero-activity, unlisted "Contact"-stage Opportunity that has a
# phone/email + full address on its Contact) so the ~25 marketplace
# eligibility/messaging tests run everywhere. Leaving them blank on an env
# just skips those tests there — it is not a failure.
MARKETPLACE_ELIGIBLE_OPPORTUNITY_ID=
MARKETPLACE_FORM_TEST_OPPORTUNITY_ID=
MARKETPLACE_FORM_TEST_OPPORTUNITY_LOCATION=

# Deal Listing Form save tests (LF_010-015). Each id is a separate unlisted,
# synthetic Opportunity that the suite REALLY lists once (one-way) — first
# as Assignment, second as Opportunity. Never reuse ELIGIBLE/FORM_TEST ids.
# Blank = those tests skip. The search term is a franchise-name fragment that
# returns Direct Invite suggestions (LF_016); blank = LF_016 skips.
MARKETPLACE_ASSIGNMENT_LISTING_OPPORTUNITY_ID=
MARKETPLACE_OPPORTUNITY_LISTING_OPPORTUNITY_ID=
MARKETPLACE_DIRECT_INVITE_SEARCH_TERM=

# Environment name — must match the .env.<ENV> file this lives in (qa | uat | staging)

# Saved login sessions (.auth/<ENV>/*.json) younger than this many minutes are
# reused instead of logging in again. Expired ones log in again on demand.
AUTH_SESSION_MAX_AGE_MIN=60
FRANCHISE_A_NAME=
# Second franchise owned by UGVILLE_USERNAME — the counterparty for bidding / Direct Invite tests.
FRANCHISE_A_OTHER_NAME=

# Listing eligibility criteria Franchise A currently FAILS in Salesforce (goodStanding, advertising, dqi); blank = all pass.
MP_FAILING_CRITERIA=
